# Copy to .env and adjust if you like. docker-compose also has these as inline defaults,
# so `docker compose up` works even without a .env file.

# --- Postgres: OWNER / admin role (runs migrations + seed, BYPASSES RLS) ---
POSTGRES_DB=crewlink
POSTGRES_USER=crewlink_admin
POSTGRES_PASSWORD=crewlink_admin_pw

# --- Postgres: APP role (Django runtime connects as this; RLS IS enforced on it) ---
DB_APP_USER=crewlink_app
DB_APP_PASSWORD=crewlink_app_pw
DB_HOST=postgres
DB_PORT=5432

# --- Redis (Celery broker + counts cache) ---
REDIS_URL=redis://redis:6379/0

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-secret-change-me
DJANGO_DEBUG=1

# --- AI feature (OpenAI). Leave key empty to use the built-in offline fallback. ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=8
